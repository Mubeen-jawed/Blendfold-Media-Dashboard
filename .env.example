# PostgreSQL connection string
DATABASE_URL="postgresql://blendfold:password@localhost:5432/blendfold?schema=public"

# Random 32+ char secret used to sign session cookies (openssl rand -hex 32)
AUTH_SECRET="change-me"

# Set to "true" only when serving over HTTPS
COOKIE_SECURE="false"

# Meta Marketing API — System User / long-lived token with ads_read (+ leads_retrieval for leads)
META_ACCESS_TOKEN=""
# Optional: adds appsecret_proof to every request (recommended)
META_APP_SECRET=""
META_API_VERSION="v23.0"
# How long Meta responses are cached, in seconds
META_CACHE_SECONDS="900"
# "true" serves generated sample data instead of calling Meta (useful for local dev)
META_MOCK="false"

# Used by scripts/create-admin.mjs on first deploy
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"
